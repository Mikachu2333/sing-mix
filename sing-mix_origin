const buildFakeIpFilter = (bypass = []) =>
    uniq([
        ...["private", "google-cn", "synology", "cn"].flatMap((name) =>
            ruleSetFilterRefs(name),
        ),
        ...uniq(
            bypass.flatMap((domain) => {
                const d = String(domain || "").trim();
                if (!d) return [];
                return d.includes("*") || d.startsWith("+.") ? [d] : [`+.${d}`];
            }),
        ),
    ]);

const mergeRules = (baseRules = [], extraRules = []) => {
    const extra = Array.isArray(extraRules) ? extraRules.filter(Boolean) : [];
    if (!extra.length) return baseRules.slice();

    const matchIndex = baseRules.findIndex((rule) =>
        /^MATCH,/i.test(String(rule).trim()),
    );

    if (matchIndex === -1) return uniq([...baseRules, ...extra]);

    const isBlockRule = (rule) => /,REJECT(?:,|$)/i.test(String(rule).trim());
    // 插入点 = 拦截链末尾。拦截链（广告规则集及其镜像备份 + 自定义屏蔽 + 进程规则）现在紧跟在
    // 白名单（强制代理）之后，所以不能从 0 开始扫：先定位第一条 REJECT，再吃掉其后的连续拦截段。
    // 继承来的 DIRECT 只能插在拦截链之后、gfw/ai/tg 等代理规则之前——前者防止订阅直连顶掉
    // 「强制屏蔽」，后者才能让自定义直连抢先命中。
    let insertIndex = baseRules.findIndex(isBlockRule);
    if (insertIndex === -1) insertIndex = 0;
    while (
        insertIndex < baseRules.length &&
        isBlockRule(baseRules[insertIndex])
    ) {
        insertIndex++;
    }

    return uniq([
        ...baseRules.slice(0, insertIndex),
        ...extra,
        ...baseRules.slice(insertIndex),
    ]);
};

const pickDirectRules = (rules = []) =>
    rules.filter((rule) => {
        const r = String(rule || "").trim();
        if (!r || r.startsWith("#")) return false;
        // 兜底 MATCH 规则不属于自定义直连：保留它会覆盖新配置的 MATCH,main
        if (/^MATCH,/i.test(r)) return false;
        return /,DIRECT(?:,|$)/i.test(r);
    });

