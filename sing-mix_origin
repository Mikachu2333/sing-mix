        (acc, proxy) => {
            if (!proxy || !proxy.name) return acc;
            (infoFilter.test(proxy.name)
                ? acc.infoProxies
                : acc.normalProxies
            ).push(proxy);
            return acc;
        },
        { infoProxies: [], normalProxies: [] },
    );

const classifyProxiesByRegion = (normalProxies = [], regions = []) => {
    const regionGroupsData = regions.map((r) => ({
