const DEFAULT_RESOURCE_MIRROR =
    "https://cdn.jsdelivr.net/gh/{repo}@{ref}/{path}";

const activeMirrors = () => {
    const list = uniq(RESOURCE_MIRRORS.map((tpl) => String(tpl || "").trim()));
    if (!list.length) return [DEFAULT_RESOURCE_MIRROR];
    const limit = Math.min(
        Math.max(1, Number(RESOURCE_MIRROR_MAX) || 1),
        list.length,
    );
    return list.slice(0, limit);
};

const buildMirrorUrl = (tpl, repo, ref, path) =>
    String(tpl)
        .replace(/\{repo\}/g, repo)
        .replace(/\{ref\}/g, ref)
        .replace(/\{path\}/g, path);

// 第 index 个镜像上的资源地址；超出已启用镜像数量时返回空字符串
const buildResourceUrl = (repo, ref, path, index = 0) => {
    const tpl = activeMirrors()[index];
    return tpl ? buildMirrorUrl(tpl, repo, ref, path) : "";
};

