// 规则集规则链：主镜像规则在前，备份镜像规则紧随其后。
// 主 provider 下载失败时其规则集为空、匹配不到任何流量，随后由同一条链上的备份 provider 命中。
const ruleSetChain = (base, policy, options = "") => {
    const suffix = options ? `,${options}` : "";
    return providerVariants(base).map(
        (providerName) => `RULE-SET,${providerName},${policy}${suffix}`,
    );
};

// hasNodes 为 false 时（订阅无节点或节点全部被过滤）不引用不存在的策略组
const buildStaticRules = (hasNodes) => {
    const proxyTarget = hasNodes ? "main" : "REJECT";
    const rules = [
        // 规则是首匹配，强制代理必须排在广告规则集之前：否则这些域名一旦被 category-ads-all
        // 收录（例如 anti-AD 系源就含 collector.github.com），REJECT 会先吃掉它，这里等于没写。
        ...uniq(FORCE_PROXY_DOMAINS).map((d) => `DOMAIN,${d},${proxyTarget}`),

        ...ruleSetChain("category-ads-all", "REJECT"),

        // 自定义屏蔽
        ...uniq(CUSTOM_BLOCK_DOMAINS).map((d) => `DOMAIN-SUFFIX,${d},REJECT`),

        // Grok 访问 storage.googleapis.com 时强制拒绝
        "AND,((PROCESS-NAME,grok.exe),(DOMAIN-SUFFIX,storage.googleapis.com)),REJECT",

        ...uniq(BYPASS_DOMAINS).map((d) => `DOMAIN-SUFFIX,${d},DIRECT`),

        ...ruleSetChain("cloudflare", "DIRECT"),
        ...ruleSetChain("private", "DIRECT"),
        ...ruleSetChain("private-ip", "DIRECT", "no-resolve"),
        ...ruleSetChain("googlefcm", "DIRECT"),
        ...ruleSetChain("google-cn", "DIRECT"),
        ...ruleSetChain("synology", "DIRECT"),
        "DOMAIN-SUFFIX,sharepoint.com,DIRECT",
        ...ruleSetChain("microsoft@cn", "DIRECT"),
        ...ruleSetChain("category-game-platforms-download@cn", "DIRECT"),
    ];

    rules.push(
        ...ruleSetChain("category-ai-!cn", hasNodes ? "ai" : "REJECT"),
        ...ruleSetChain("telegram", hasNodes ? "tg" : "REJECT"),
        ...ruleSetChain("gfw", proxyTarget),
    );

    rules.push(...ruleSetChain("cn", "DIRECT"));
    rules.push(...ruleSetChain("cn-ip", "DIRECT", "no-resolve"));
    // 仅对已进入内核且未命中前面规则的 IPv6 目标兜底；此前 DIRECT 规则仍然优先。
    // 系统路由绕过 TUN 的流量不会执行这条规则。
    // no-resolve 不会为域名主动解析目标 IP；带有目标 IP 的连接仍可匹配。
    rules.push(`IP-CIDR6,::/0,${proxyTarget},no-resolve`);
    rules.push(`MATCH,${proxyTarget}`);

    return rules;
};

