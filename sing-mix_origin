    new RegExp(
        arr
            .map((raw) => {
                const token = String(raw).trim().toUpperCase();
                const escaped = escapeRegex(token);
                return /^[A-Z]{2,3}$/.test(token)
                    ? `(?:^|[^A-Z])${escaped}(?:[^A-Z]|$)`
                    : escaped;
            })
            .join("|"),
        "i",
    );

